# ==============================================================================
# Git Ignore Configuration - Sales Dashboard Analysis
# ==============================================================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Environment & Secret Configuration ---
.env
.env.*
!.env.example
secrets.json
credentials.json

# --- Jupyter Notebooks & IDE Caches ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Data Directory Governance ---
# Exclude raw and processed datasets from Git by default to protect proprietary data
# while keeping folder structure intact via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Exclude generated analytics outputs except directory marker
outputs/*
!outputs/.gitkeep

# Intentional exceptions:
# Non-sensitive, public sample files placed in sample directories can be tracked:
# !data/sample/*.csv
# !data/sample/*.json

# --- Power BI Temporary & Backup Files ---
*.tmp
~$*.pbix
*.pbix.bak
*.pbit.bak

# --- Operating System Files (Windows / macOS) ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
